# Postgres
POSTGRES_USER=ecostride
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ecostride

# Backend
DATABASE_URL=postgres://ecostride:change-me-strong@db:5432/ecostride?sslmode=disable
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-32+char-random
REFRESH_SECRET=replace-with-32+char-random
CORS_ORIGIN=*
BASE_URL=http://VM_PUBLIC_IP
MAX_UPLOAD_MB=10
MEDIA_STORAGE=local

# Email (console = log to stdout; switch to smtp in prod)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# M-Pesa (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_WEBHOOK_TOKEN=
MPESA_ALLOWED_IPS=

# Frontend
NEXT_PUBLIC_API_BASE=/api/v1
